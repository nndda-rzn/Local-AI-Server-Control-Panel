NODE_ENV=development
PORT=5500

# Auth
JWT_SECRET=cdss-user-example
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123 

# Database (will be created if missing)
DATABASE_PATH=/server/data/sqlite/panel.db

# Whitelists
ALLOWED_PROJECT_ROOT=/server/apps
ALLOWED_MODEL_ROOT=/server/data/models
ALLOWED_CONTAINER_PREFIXES=panel-,nginx-test,cdss-,ai-,postgres,redis

# Limits
LOG_TAIL_LIMIT=200
MAX_MODEL_UPLOAD_MB=500

# Optional: HEALTH_CHECK_TARGETS=name|http://host:port,...
HEALTH_CHECK_TARGETS=

# Optional: AI inference service URL untuk POST /api/ai/test-inference
AI_INFERENCE_URL=

# Optional: nama container service inference yang dipakai tombol "Restart Inference Service"
AI_INFERENCE_CONTAINER=ai-inference

# Optional: scheduler backup otomatis (kosongkan untuk disable)
# Format cron 5-field. Contoh: "0 2 * * *" = 02:00 setiap hari
BACKUP_SCHEDULE_CRON=
BACKUP_SCHEDULE_SCOPES=db,models
BACKUP_SCHEDULE_LABEL=auto
BACKUP_SCHEDULE_TZ=Asia/Jakarta

# Optional: notification webhook (kosongkan = disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=

# Optional: watchdog container down/unhealthy
# Contoh: "*/2 * * * *" = setiap 2 menit
WATCHDOG_CRON=
WATCHDOG_TARGETS=
WATCHDOG_COOLDOWN_MS=900000
WATCHDOG_TZ=Asia/Jakarta
